# Copy this file to "keystore.properties" (same folder, next to settings.gradle) and
# fill in your real values. keystore.properties itself is git-ignored -- it should never
# be committed, since it holds your keystore's location and passwords.
#
# Use forward slashes in storeFile even on Windows (C:/Users/you/keystores/...) --
# backslashes are escape characters in .properties files and will get mangled.
#
# If you don't have a release keystore yet, generate one with (from any terminal with a
# JDK's bin directory available):
#
#   keytool -genkeypair -v -keystore C:/path/to/descent-android-release.jks -alias descent-android -keyalg RSA -keysize 2048 -validity 10000
#
# Keep the resulting .jks file OUTSIDE this repo (anywhere .gitignore can't accidentally
# miss it), and back it up somewhere safe along with these passwords -- if you lose it,
# you can never sign a continuable update to this app again under the same identity, and
# every existing install would need to be uninstalled before it could take a new one.

storeFile=C:/Users/Matt/keystores/descent-android-release.jks
storePassword=changeme
keyAlias=descent-android
keyPassword=changeme
